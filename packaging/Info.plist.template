<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Rendered by scripts/bundle.sh: @VERSION@ -> [workspace.package] version,
  @BUILD@ -> git commit count (or a date stamp), @YEAR@ -> current year;
  @APP_NAME@, @BUNDLE_ID@, @HANDLER_RANK@, @URL_SCHEME@ -> Parquetry or
  Parquetry Preview (PARQUETRY_VARIANT=preview).
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleIdentifier</key>
	<string>@BUNDLE_ID@</string>
	<key>CFBundleName</key>
	<string>@APP_NAME@</string>
	<key>CFBundleDisplayName</key>
	<string>@APP_NAME@</string>
	<key>CFBundleExecutable</key>
	<string>parquetry</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@BUILD@</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- Sparkle: automatic updates. The feed and its archives are signed with the
	     EdDSA key whose public half is below (packaging/sparkle_public_key.txt). -->
	<key>SUFeedURL</key>
	<string>@SPARKLE_FEED_URL@</string>
	<key>SUPublicEDKey</key>
	<string>@SPARKLE_PUBLIC_KEY@</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © @YEAR@ Parquetry contributors. MIT License.</string>

	<!-- Documents Parquetry can open (Finder "Open With", drag onto Dock icon, `open -a`). -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Apache Parquet File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>@HANDLER_RANK@</string>
			<key>CFBundleTypeIconSystemGenerated</key>
			<true/>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.apache.parquet</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Apache Arrow / Feather File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>@HANDLER_RANK@</string>
			<key>CFBundleTypeIconSystemGenerated</key>
			<true/>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.apache.arrow.file</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>CSV / TSV Document</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.comma-separated-values-text</string>
				<string>public.tab-separated-values-text</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>JSON / JSON Lines Document</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.json</string>
				<string>io.parquetry.jsonl</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Excel Workbook</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.openxmlformats.spreadsheetml.sheet</string>
			</array>
		</dict>
		<dict>
			<!-- Dropping a folder of partitioned Parquet files onto the app. -->
			<key>CFBundleTypeName</key>
			<string>Folder</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>None</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.folder</string>
			</array>
		</dict>
	</array>

	<!--
	  Imported (not exported) so we never claim ownership of these identifiers:
	  if another app or a future macOS release declares them, the system's
	  declaration wins and ours is only a fallback.
	-->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.apache.parquet</string>
			<key>UTTypeDescription</key>
			<string>Apache Parquet File</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>parquet</string>
					<string>parq</string>
					<string>pq</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.apache.parquet</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.apache.arrow.file</string>
			<key>UTTypeDescription</key>
			<string>Apache Arrow IPC File</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>arrow</string>
					<string>feather</string>
					<string>ipc</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.apache.arrow.file</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>io.parquetry.jsonl</string>
			<key>UTTypeDescription</key>
			<string>JSON Lines Document</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.text</string>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>jsonl</string>
					<string>ndjson</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/jsonl</string>
					<string>application/x-ndjson</string>
				</array>
			</dict>
		</dict>
	</array>

	<!-- parquetry://open?url=<percent-encoded path or URL>  (used by the CLI for s3://, https://, globs). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>@BUNDLE_ID@</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>@URL_SCHEME@</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
